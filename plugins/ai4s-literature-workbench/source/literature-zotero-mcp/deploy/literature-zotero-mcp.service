[Unit]
Description=Literature Zotero MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/literature-zotero-mcp/.env
ExecStart=/usr/bin/docker run --rm --name literature-zotero-mcp -p 127.0.0.1:3939:3939 \
  --env-file /opt/literature-zotero-mcp/.env -v literature-zotero-mcp-data:/data literature-zotero-mcp:local
ExecStop=/usr/bin/docker stop -t 30 literature-zotero-mcp
Restart=always
RestartSec=5
# Docker forwards SIGTERM so the MCP drains and flushes within stop_grace_period.

[Install]
WantedBy=multi-user.target
