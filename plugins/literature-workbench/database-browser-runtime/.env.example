# Optional private application-data directory. Never point this into the repository.
# LITERATURE_DATABASE_BROWSER_DATA_DIR=/absolute/private/path

# V1 is deliberately visible-only. `true` is rejected at startup.
LITERATURE_DATABASE_BROWSER_HEADLESS=false

# Reuse locally installed stable Chrome when available. Chromium is only a fallback.
LITERATURE_DATABASE_BROWSER_CHANNEL=chrome

# Close an idle browser context after this many minutes when no jobs are active.
LITERATURE_DATABASE_BROWSER_IDLE_TTL_MINUTES=30

# Preserve failure-only diagnostics for this many days.
LITERATURE_DATABASE_BROWSER_DIAGNOSTIC_RETENTION_DAYS=7
