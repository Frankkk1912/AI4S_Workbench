# Private data root. Do not use a repository, Desktop, Downloads, or cloud-sync folder.
# LITERATURE_FULLTEXT_DATA_DIR=
# Shared owner-private exchange root read by the Zotero MCP apply tool.
# LITERATURE_FULLTEXT_EXCHANGE_ROOT=
# Maximum fetched PDF bytes (default 50 MiB; hard maximum 100 MiB).
# LITERATURE_FULLTEXT_MAX_PDF_MB=50
# HTTP timeout in seconds (default 30; hard maximum 120).
# LITERATURE_FULLTEXT_HTTP_TIMEOUT_SEC=30
